    'chart-point-reading.tsx': 'import { useEffect, useState } from "react";\n' +
      '\n' +
      'export type ChartPointReadingField = { key: string; label: string; unit: string };\n' +
      'type DatedPoint = Record<string, unknown> & { date: Date };\n' +
      '\n' +
      'function dateName(date: Date) {\n' +
      '  return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;\n' +
      '}\n' +
      '\n' +
      'function reading(value: unknown, unit: string) {\n' +
      '  if (typeof value !== "string" && (typeof value !== "number" || !Number.isFinite(value))) return "缺测";\n' +
      '  return `${String(value)}${unit ? ` ${unit}` : ""}`;\n' +
      '}\n' +
      '\n' +
      '/** Private example reader: a date identifies a reading independently of its array position. */\n' +
      'export function ChartPointReading({ data, fields }: {\n' +
      '  data: readonly DatedPoint[];\n' +
      '  fields: readonly ChartPointReadingField[];\n' +
      '}) {\n' +
      '  const [selectedDate, setSelectedDate] = useState<number | null>(() => data[0]?.date.getTime() ?? null);\n' +
      '  const current = data.find(point => point.date.getTime() === selectedDate);\n' +
      '  useEffect(() => {\n' +
      '    if (selectedDate !== null && !current) setSelectedDate(null);\n' +
      '  }, [current, selectedDate]);\n' +
      '\n' +
      '  return <div data-point-reading>\n' +
      '    <label className="rain-chart-example-control">读取日期 <select aria-label="读取日期" disabled={data.length === 0}\n' +
      '      value={current ? String(selectedDate) : ""} onChange={event => setSelectedDate(event.target.value === "" ? null : Number(event.target.value))}>\n' +
      '      <option value="">选择日期</option>\n' +
      '      {data.map(point => <option key={point.date.getTime()} value={String(point.date.getTime())}>{dateName(point.date)}</option>)}\n' +
      '    </select></label>\n' +
      '    <p className="rain-chart-note" role="status" aria-live="polite" aria-atomic="true" data-point-reading-date={current?.date.toISOString()}>\n' +
      '      {current ? `${dateName(current.date)} · ${fields.map(field => `${field.label} ${reading(current[field.key], field.unit)}`).join(" · ")}`\n' +
      '        : data.length === 0 ? "当前没有可读日期" : "请选择读取日期"}\n' +
      '    </p>\n' +
      '  </div>;\n' +
      '}\n',
