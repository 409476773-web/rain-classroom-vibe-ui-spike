      '      ],\n' +
      '      edges: [\n' +
      '        { id: "programming-data", source: "programming", target: "data-structures", relation: "prerequisite", directed: true, value: 4 },\n' +
      '        { id: "math-data", source: "mathematics", target: "data-structures", relation: "prerequisite", directed: true, value: 3 },\n' +
      '        { id: "data-algorithms", source: "data-structures", target: "algorithms", relation: "prerequisite", directed: true, value: 4 },\n' +
      '        { id: "algorithms-data", source: "algorithms", target: "data-structures", relation: "related", directed: false },\n' +
      '        { id: "programming-database", source: "programming", target: "database", relation: "prerequisite", directed: true, value: 3 },\n' +
      '        { id: "math-networks", source: "mathematics", target: "networks", relation: "supports", directed: true, value: 2 },\n' +
      '        { id: "algorithms-intelligence", source: "algorithms", target: "intelligence", relation: "prerequisite", directed: true, value: 4 },\n' +
      '        { id: "database-engineering", source: "database", target: "engineering", relation: "supports", directed: true, value: 3 },\n' +
