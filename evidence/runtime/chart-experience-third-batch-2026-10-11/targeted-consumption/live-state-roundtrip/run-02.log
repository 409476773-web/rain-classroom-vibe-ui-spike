      '  recipe: ChartRecipe;\n' +
      '  revision: number;\n' +
      '  replay: number;\n' +
      '  reduced: boolean;\n' +
      '  /** False outside the viewport or while the document is hidden. Stop all loops. */\n' +
      '  active: boolean;\n' +
      '  settings?: VariantSettings;\n' +
      '  onSettingsChange?: (patch: VariantSettings) => void;\n' +
      '  curveName?: string;\n' +
      '  onCurveChange?: (value: string) => void;\n' +
      '};\n' +
      '\n' +
      'export function useVariantSetting<K extends keyof VariantSettings>(key: K, fallback: Required<VariantSettings>[K], props: Pick<VariantExampleProps, "settings" | "onSettingsChange">): [Required<VariantSettings>[K], (value: SetStateAction<Required<VariantSettings>[K]>) => void] {\n' +
      '  const [local, setLocal] = useState(fallback);\n' +
      '  const current = props.settings?.[key] === undefined ? local : props.settings[key] as Required<VariantSettings>[K];\n' +
      '  const set = (value: SetStateAction<Required<VariantSettings>[K]>) => {\n' +
      '    const next = typeof value === "function" ? value(current) : value;\n' +
      '    setLocal(next);\n' +
      '    props.onSettingsChange?.({ [key]: next });\n' +
      '  };\n' +
      '  return [current, set];\n' +
      '}\n' +
      '\n' +
      'export function useChartReducedMotion() {\n' +
      '  const [reduced, setReduced] = useState(() => typeof matchMedia === "function" && matchMedia("(prefers-reduced-motion: reduce)").matches);\n' +
      '  useEffect(() => {\n' +
      '    if (typeof matchMedia !== "function") return;\n' +
      '    const media = matchMedia("(prefers-reduced-motion: reduce)");\n' +
      '    const change = () => setReduced(media.matches);\n' +
      '    change();\n' +
      '    media.addEventListener("change", change);\n' +
      '    return () => media.removeEventListener("change", change);\n' +
      '  }, []);\n' +
      '  return reduced;\n' +
      '}\n' +
      '\n' +
      'export const immediate = { type: "tween" as const, duration: 0 };\n' +
      'export const seriesColors = [1, 2, 3, 4, 5].map(index => `var(--chart-${index})`);\n' +
      '\n' +
      'export function trendCurve(data: Record<string, unknown>[], dataKey: string) {\n' +
      '  const values = data.map(point => point[dataKey] as number | null);\n' +
      '  // Preserve flat readings and sharply slowing endpoints in the calibrated mock scenes.\n' +
      '  if (values.some((value, index) => value == null || value === 0 || index > 0 && value === values[index - 1])) return curveMonotoneX;\n' +
      '  const slopes = values.slice(1).map((value, index) => value! - values[index]!);\n' +
      '  const slowsAtEdge = slopes.length > 1 && (Math.abs(slopes[0]!) < Math.abs(slopes[1]!) / 3 || Math.abs(slopes.at(-1)!) < Math.abs(slopes.at(-2)!) / 3);\n' +
