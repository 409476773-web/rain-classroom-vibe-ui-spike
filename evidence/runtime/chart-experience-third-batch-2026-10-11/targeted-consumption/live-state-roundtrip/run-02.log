      '};\n' +
      '\n' +
      'export function useVariantSetting<K extends keyof VariantSettings>(key: K, fallback: Required<VariantSettings>[K], props: Pick<VariantExampleProps, "settings" | "onSettingsChange">): [Required<VariantSettings>[K], (value: SetStateAction<Required<VariantSettings>[K]>) => void] {\n' +
