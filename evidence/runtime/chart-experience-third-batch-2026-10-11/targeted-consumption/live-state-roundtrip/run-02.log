      '        { id: "derivative-optimization", source: "derivative", target: "optimization", relation: "applies", directed: true, value: 3 },\n' +
      '        { id: "integral-dynamics", source: "integral", target: "dynamics", relation: "applies", directed: true, value: 3 },\n' +
      '        { id: "numerical-dynamics", source: "numerical", target: "dynamics", relation: "applies", directed: true, value: 4 },\n' +
      '        { id: "numerical-optimization", source: "numerical", target: "optimization", relation: "applies", directed: true, value: 2 },\n' +
      '      ],\n' +
      '    },\n' +
      '    {\n' +
      '      id: "courses", reference: "CH-083", title: "课程先修与能力支撑关系",\n' +
      '      description: "全 Mock 示例：11门课程、19条关系，包含跨类别连接、多对多支撑与双向支撑。先修箭头由先修课指向后续课；同一课程对的不同关系使用独立曲线。",\n' +
      '      categories: [{ id: "foundation", label: "基础课程" }, { id: "professional", label: "专业课程" }, { id: "elective", label: "拓展课程" }],\n' +
      '      relations: [{ id: "prerequisite", label: "先修关系" }, { id: "related", label: "内容相似" }, { id: "supports", label: "能力支撑" }],\n' +
      '      nodes: [\n' +
      '        { id: "programming", label: "程序设计基础", category: "foundation", x: .07, y: .46 },\n' +
      '        { id: "mathematics", label: "离散数学", category: "foundation", x: .20, y: .22 },\n' +
      '        { id: "data-structures", label: "数据结构", category: "professional", x: .47, y: .09 },\n' +
      '        { id: "algorithms", label: "算法设计", category: "professional", x: .19, y: .70 },\n' +
      '        { id: "database", label: "数据库原理", category: "professional", x: .47, y: .43 },\n' +
      '        { id: "networks", label: "计算机网络", category: "professional", x: .34, y: .88 },\n' +
      '        { id: "intelligence", label: "人工智能导论", category: "elective", x: .91, y: .44 },\n' +
