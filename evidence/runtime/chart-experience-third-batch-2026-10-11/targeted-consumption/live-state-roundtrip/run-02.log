      '        { id: "algorithms-engineering", source: "algorithms", target: "engineering", relation: "supports", directed: true, value: 3 },\n' +
      '        { id: "database-networks", source: "database", target: "networks", relation: "related", directed: false },\n' +
      '        { id: "programming-algorithms", source: "programming", target: "algorithms", relation: "prerequisite", directed: true, value: 3 },\n' +
      '        { id: "data-database", source: "data-structures", target: "database", relation: "supports", directed: true, value: 3 },\n' +
      '        { id: "math-database", source: "mathematics", target: "database", relation: "supports", directed: true, value: 2 },\n' +
      '        { id: "statistics-database", source: "statistics", target: "database", relation: "supports", directed: true, value: 2 },\n' +
