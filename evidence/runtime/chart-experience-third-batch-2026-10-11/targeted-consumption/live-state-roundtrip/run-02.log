      '  ] as const;\n' +
      '  return Array.from({ length: state === "single" ? 1 : 24 }, (_, i) => {\n' +
      '    const enrolled = state === "zero" ? 0 : readings[step]![i]!;\n' +
      '    const completed = Math.round(enrolled * (.64 + Math.sin(i * .18 + [0, .6, -.4][step]!) * .09));\n' +
      '    const date = new Date(2026, 8, i + 1);\n' +
      '    assertValidDate(date);\n' +
      '    assertNonNegativeCount(enrolled); assertNonNegativeCount(completed);\n' +
      '    return {\n' +
      '      date, enrolled, completed,\n' +
      '      rate: enrolled ? completed / enrolled * 100 : null,\n' +
      '      returned: Math.round(enrolled * (.39 + Math.cos(i * .17 + step * .5) * .08)),\n' +
      '      answered: Math.round(enrolled * (.31 + Math.sin(i * .16 + 1 + step * .4) * .07)),\n' +
      '      reviewed: Math.round(enrolled * (.18 + Math.cos(i * .14 + .7 + step * .6) * .05)),\n' +
