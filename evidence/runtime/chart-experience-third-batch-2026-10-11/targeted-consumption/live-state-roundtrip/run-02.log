    'chart-variants/shared.tsx': 'import { ChartLegend, curveMonotoneX, curveNatural, type LegendItem as LegendItemData } from "@rain-next/ui/charts";\n' +
      'import type { ChartRecipe } from "../chart-catalog";\n' +
      'import type { ChartBoundaryScenario } from "../chart-data";\n' +
      'import { useEffect, useState, type ReactNode, type SetStateAction } from "react";\n' +
      '\n' +
      'export type VariantSettings = {\n' +
      '  boundaryScenario?: ChartBoundaryScenario;\n' +
