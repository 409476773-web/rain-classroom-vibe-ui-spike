      '}\n',
    'chart-data.ts': 'import type { FeatureCollection, Geometry } from "geojson";\n' +
      'import worldJson from "./chart-variants/data/world.geojson?raw";\n' +
      '\n' +
      'export type ChartState = "normal" | "empty" | "zero" | "long" | "single" | "missing" | "invalid";\n' +
      '/** Named documentation boundaries; ordinary ChartState and normal mock arrays stay unchanged. */\n' +
      'export type ChartBoundaryScenario = "normal" | "pie-small" | "pie-remove" | "ring-zero" | "ring-full" | "ring-zero-goal" | "ring-over" | "funnel-missing" | "funnel-growth" | "funnel-zero-entry" | "funnel-above-entry" | "sankey-thin" | "sankey-zero-link" | "scatter-dense" | "scatter-overlap" | "candlestick-dense" | "candlestick-flat" | "profit-loss-near-zero" | "profit-loss-zero-run";\n' +
      'export type TimelinePoint = Record<string, unknown> & { date: Date; enrolled: number; completed: number; rate: number | null };\n' +
