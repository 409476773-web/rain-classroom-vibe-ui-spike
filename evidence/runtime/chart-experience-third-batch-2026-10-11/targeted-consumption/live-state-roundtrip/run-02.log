      '  </table></div></details>;\n' +
      '}\n',
    'chart-data.ts': 'import type { FeatureCollection, Geometry } from "geojson";\n' +
      'import worldJson from "./chart-variants/data/world.geojson?raw";\n' +
      '\n' +
      'export type ChartState = "normal" | "empty" | "zero" | "long" | "single" | "missing" | "invalid";\n' +
      '/** Named documentation boundaries; ordinary ChartState and normal mock arrays stay unchanged. */\n' +
      'export type ChartBoundaryScenario = "normal" | "pie-small" | "pie-remove" | "ring-zero" | "ring-full" | "ring-zero-goal" | "ring-over" | "funnel-missing" | "funnel-growth" | "funnel-zero-entry" | "funnel-above-entry" | "sankey-thin" | "sankey-zero-link" | "scatter-dense" | "scatter-overlap" | "candlestick-dense" | "candlestick-flat" | "profit-loss-near-zero" | "profit-loss-zero-run";\n' +
      'export type TimelinePoint = Record<string, unknown> & { date: Date; enrolled: number; completed: number; rate: number | null };\n' +
      'export const SERIES = [\n' +
      '  { key: "enrolled", label: "参与人数", color: "var(--chart-1)" },\n' +
      '  { key: "completed", label: "完成人数", color: "var(--chart-2)" },\n' +
      '  { key: "returned", label: "复习人数", color: "var(--chart-3)" },\n' +
      '  { key: "answered", label: "答题人数", color: "var(--chart-4)" },\n' +
      '  { key: "reviewed", label: "讨论人数", color: "var(--chart-5)" },\n' +
      '] as const;\n' +
      '\n' +
      'export function dateLabel(value: Date) {\n' +
      '  return `${value.getMonth() + 1}月${value.getDate()}日`;\n' +
      '}\n' +
      '\n' +
      'export function exampleLabel(label: string, state: ChartState) {\n' +
      '  return state === "long" ? `${label} · 综合课程学习情况` : label;\n' +
      '}\n' +
      '\n' +
      'export function makeTimeline(revision = 0, state: ChartState = "normal"): TimelinePoint[] {\n' +
      '  if (state === "empty") return [];\n' +
      '  const step = revision % 3;\n' +
      '  const readings = [\n' +
      '    [184, 188, 198, 214, 235, 258, 282, 304, 322, 334, 338, 334, 323, 307, 290, 275, 265, 260, 264, 276, 295, 317, 339, 356],\n' +
      '    [218, 223, 232, 247, 266, 286, 304, 318, 327, 330, 325, 313, 297, 281, 267, 260, 263, 274, 292, 314, 335, 351, 359, 360],\n' +
