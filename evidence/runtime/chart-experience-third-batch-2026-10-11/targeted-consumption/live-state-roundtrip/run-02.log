      '  [[242, 148, 92, 116, 66], [216, 202, 124, 162, 88], [296, 172, 146, 132, 78], [198, 104, 96, 86, 58], [318, 284, 188, 214, 106], [226, 128, 112, 104, 74]],\n' +
      '  [[284, 196, 182, 144, 96], [176, 160, 102, 122, 66], [264, 134, 126, 112, 82], [238, 214, 148, 172, 96], [304, 156, 140, 124, 78], [212, 104, 98, 92, 62]],\n' +
