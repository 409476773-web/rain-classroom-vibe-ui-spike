    'chart-business/matrix-examples.tsx': 'import { useId, useState } from "react";\n' +
      'import { Button } from "@rain-next/ui";\n' +
      'import { MatrixChart, type RainChartRecipe } from "@rain-next/ui/charts";\n' +
      'import type { ChartState } from "../chart-data";\n' +
      'import { makeMatrixFixtures, type MatrixFixture } from "./matrix-data";\n' +
      '\n' +
      'export interface MatrixExamplesProps {\n' +
      '  state?: ChartState;\n' +
      '  revision?: number;\n' +
      '  reduced?: boolean;\n' +
      '  replay?: number;\n' +
      '  descending?: boolean;\n' +
      '  fixtureId?: MatrixFixture["id"];\n' +
      '  recipe?: RainChartRecipe;\n' +
      '  initialSize?: 4 | 6 | 12;\n' +
      '  onSizeChange?: (size: 4 | 6 | 12) => void;\n' +
      '}\n' +
      '\n' +
      'export function MatrixExamples({ state = "normal", revision = 0, reduced = false, replay = 0, descending = false, fixtureId, recipe = "monochrome-blue", initialSize = 6, onSizeChange }: MatrixExamplesProps) {\n' +
      '  const headingId = useId();\n' +
      '  const [similaritySize, setSimilaritySize] = useState<4 | 6 | 12>(initialSize);\n' +
      '  const fixtures = makeMatrixFixtures(revision, state, similaritySize).filter(fixture => !fixtureId || fixture.id === fixtureId);\n' +
      '  return <section className="rain-business-section" data-rain-id="doc-chart-matrix" aria-labelledby={fixtureId ? undefined : headingId}>\n' +
      '    {!fixtureId && <h2 id={headingId}>分类交叉矩阵</h2>}\n' +
      '    <p className="rain-business-note">示例数据</p>\n' +
      '    {(!fixtureId || fixtureId === "course-similarity") && <div className="rain-business-controls" role="group" aria-label="相似度矩阵规模">{([4, 6, 12] as const).map(size => <Button key={size} size="small" variant="secondary" aria-pressed={similaritySize === size} onClick={() => { setSimilaritySize(size); onSizeChange?.(size); }}>{size}×{size}</Button>)}</div>}\n' +
      '    {fixtures.map(fixture => {\n' +
      '      const invalid = fixture.cells.some(cell => cell.kind === "value" && !Number.isFinite(cell.value));\n' +
      '      return <section key={fixture.id} className="rain-business-section" data-matrix-example={fixture.id} aria-label={fixture.caption}>\n' +
      '        {invalid ? <><h3>{fixture.caption}</h3><p role="alert">无效数据：请提供有效的矩阵读数。</p></> : <MatrixChart key={`${fixture.id}-${replay}`} caption={fixture.caption} rowHeaderLabel={fixture.rowHeaderLabel} data-recipe={recipe}\n' +
      '          rows={descending ? [...fixture.rows].reverse() : fixture.rows} columns={descending ? [...fixture.columns].reverse() : fixture.columns}\n' +
      '          cells={fixture.cells} encoding={fixture.encoding} valueFormat={fixture.valueFormat} reducedMotion={reduced} />}\n' +
      '        <p className="rain-business-note">{fixture.description}</p>\n' +
      '      </section>;\n' +
      '    })}\n' +
      '  </section>;\n' +
      '}\n',
    'chart-business/matrix-data.ts': 'import type { MatrixAxisItem, MatrixCell, MatrixEncoding } from "@rain-next/ui/charts";\n' +
      'import type { ChartState } from "../chart-data";\n' +
      '\n' +
      'export interface MatrixFixture {\n' +
      '  id: "weekday-hour" | "course-version" | "course-similarity" | "course-count" | "support-level";\n' +
      '  caption: string;\n' +
      '  description: string;\n' +
      '  sourceIds: readonly string[];\n' +
      '  rows: MatrixAxisItem[];\n' +
      '  columns: MatrixAxisItem[];\n' +
      '  cells: MatrixCell[];\n' +
      '  encoding: MatrixEncoding;\n' +
      '  rowHeaderLabel: string;\n' +
      '  valueFormat?: (value: number) => string;\n' +
      '}\n' +
      '\n' +
      'const courseLabels = ["高等数学", "线性代数", "概率论与数理统计", "大学物理", "程序设计基础", "数据结构", "离散数学", "算法设计与分析", "计算机网络", "操作系统", "数据库原理", "软件工程"];\n' +
      'const axes = (prefix: string, labels: readonly string[]): MatrixAxisItem[] => labels.map((label, index) => ({ id: `${prefix}-${index + 1}`, label }));\n' +
      'function numericCells(rows: MatrixAxisItem[], columns: MatrixAxisItem[], reading: (row: number, column: number) => number): MatrixCell[] {\n' +
      '  return rows.flatMap((row, rowIndex) => columns.map((column, columnIndex) => ({ rowId: row.id, columnId: column.id, kind: "value" as const, value: reading(rowIndex, columnIndex) })));\n' +
      '}\n' +
      '\n' +
      '/** Deterministic Mock data; it is not connected to any school or learner records. */\n' +
      'export function makeMatrixFixtures(revision = 0, state: ChartState = "normal", similaritySize: 4 | 6 | 12 = 6): MatrixFixture[] {\n' +
      '  const change = revision % 3;\n' +
      '  const hourlyActivity = [\n' +
      '    [0, 0, 0, 0, 0, 1, 3, 6, 10, 15, 18, 14, 8, 10, 16, 19, 17, 11, 8, 13, 18, 16, 9, 3],\n' +
      '    [0, 0, 0, 0, 1, 2, 4, 8, 13, 17, 15, 12, 7, 11, 18, 20, 16, 10, 9, 14, 19, 15, 8, 2],\n' +
      '    [0, 0, 0, 0, 0, 1, 2, 5, 9, 14, 17, 15, 10, 8, 13, 18, 20, 14, 10, 12, 16, 18, 11, 4],\n' +
      '  ][change]!;\n' +
      '  const weekdayActivity = [.82, 1, .92, .96, .76, .48, .62];\n' +
      '  const courseSemesters = [\n' +
      '    [[1, 1, 2, 1], [2, 2, 2, 3], [3, 4, 3, 4], [2, 3, 3, 2], [1, 2, 1, 2], [3, 4, 4, 5]],\n' +
      '    [[1, 2, 1, 2], [2, 3, 2, 2], [4, 3, 4, 5], [3, 2, 3, 3], [2, 1, 2, 1], [4, 5, 3, 4]],\n' +
      '    [[2, 1, 1, 2], [3, 2, 3, 2], [3, 5, 4, 3], [2, 4, 2, 3], [1, 2, 2, 1], [5, 4, 5, 3]],\n' +
      '  ][change]!;\n' +
      '  const courseCounts = [[0, 62, 86, 68, 64, 54], [68, 48, 38, 88, 40, 60], [92, 82, 66, 78, 72, 68], [52, 58, 72, 44, 66, 48], [80, 74, 58, 76, 52, 62], [28, 36, 24, 42, 18, 90]];\n' +
      '  const countChanges = [[0, 0, 0, 0, 0, 0], [4, -6, 8, -4, 6, -8], [8, 7, -5, 9, -6, 4]][change]!;\n' +
      '  const supportLevels = [\n' +
      '    [[2, 2, 0, 0], [2, 2, 1, 0], [2, 2, 1, 1], [2, 1, 2, 1], [2, 2, 2, 1], [2, 2, 2, 2]],\n' +
      '    [[2, 1, 0, 0], [2, 2, 0, 1], [2, 2, 1, 0], [1, 2, 2, 1], [2, 1, 2, 2], [2, 2, 1, 2]],\n' +
      '    [[2, 2, 1, 0], [2, 1, 1, 0], [1, 2, 2, 1], [2, 1, 2, 0], [2, 2, 1, 2], [2, 1, 2, 2]],\n' +
      '  ][change]!;\n' +
      '  const days = axes("weekday", ["周一", "周二", "周三", "周四", "周五", "周六", "周日"]);\n' +
      '  const hours = axes("hour", Array.from({ length: 24 }, (_, hour) => `${String(hour).padStart(2, "0")}:00`));\n' +
      '  const courses = axes("course", courseLabels.slice(0, 6));\n' +
      '  const versions = axes("version", ["2022 版", "2023 版", "2024 版", "2025 版"]);\n' +
      '  const similarities = axes("course", courseLabels.slice(0, similaritySize));\n' +
      '  const categories = axes("category", ["通识课程", "学科基础", "专业必修", "专业选修", "实践课程", "创新课程"]);\n' +
      '  const colleges = axes("college", ["计算机学院", "经济管理学院", "人文学院", "理学院", "外国语学院", "教育学院"]);\n' +
      '  const requirements = axes("requirement", ["知识与能力", "分析与表达", "协作与实践", "创新与反思"]);\n' +
      '  const fixtures: MatrixFixture[] = [\n' +
      '    { id: "weekday-hour", caption: "每周学习时段 · 次数", description: "按星期与小时比较学习次数，0 也是有效观测。", sourceIds: ["CH026", "CH033", "CH044", "CH054"],\n' +
      '      rows: days, columns: hours, cells: numericCells(days, hours, (row, column) => Math.round(hourlyActivity[column]! * weekdayActivity[row]!)).slice(0, -1),\n' +
      '      encoding: { kind: "heat", domain: [0, 20] }, rowHeaderLabel: "星期", valueFormat: String },\n' +
      '    { id: "course-version", caption: "课程与培养方案版本 · 开课学期", description: "学期按 1—8 排列；未设学期与无该课程分别记录。", sourceIds: ["CH076", "CH115"],\n' +
      '      rows: courses, columns: versions, cells: numericCells(courses, versions, (row, column) => courseSemesters[row]![column]!).map<MatrixCell>((cell, index) => index === 2\n' +
      '        ? { rowId: cell.rowId, columnId: cell.columnId, kind: "missing", label: "未设学期" }\n' +
      '        : index === 9 ? { rowId: cell.rowId, columnId: cell.columnId, kind: "not-applicable", label: "无该课程" } : cell),\n' +
      '      encoding: { kind: "heat", domain: [1, 8], steps: [1, 2, 3, 4, 5, 6, 7, 8] }, rowHeaderLabel: "课程", valueFormat: String },\n' +
      '    { id: "course-similarity", caption: "课程相似度", description: "同一课程对应两轴；方向不同的读数分别保留，缺测位置留空。", sourceIds: ["CH084", "CH087", "CH089", "CH090"],\n' +
      '      rows: similarities, columns: [...similarities], cells: numericCells(similarities, similarities, (row, column) => {\n' +
      '        if (row === column) return 1;\n' +
      '        const sameCluster = (row < 4) === (column < 4);\n' +
      '        const relatedness = sameCluster ? .86 - Math.min(5, Math.abs(row - column)) * .055 : .22 + (row + column) % 3 * .09;\n' +
      '        const directionalDifference = row < column ? .02 : -.02;\n' +
      '        return Math.round(Math.max(0, Math.min(1, relatedness + directionalDifference + [0, .05, -.06][change]!)) * 100) / 100;\n' +
      '      })\n' +
      '        .filter((_, index) => Math.floor(index / similaritySize) !== index % similaritySize || Math.floor(index / similaritySize) % 3 !== 0),\n' +
      '      encoding: { kind: "heat", domain: [0, 1] }, rowHeaderLabel: "课程", valueFormat: value => `${Math.round(value * 100)}%` },\n' +
      '    { id: "course-count", caption: "课程类别与学院 · 课程数", description: "圆面积与颜色深浅共用课程数量程；指向或用方向键查看精确课程数。", sourceIds: ["CH085", "CH088", "CH091", "CH092"],\n' +
      '      rows: categories, columns: colleges, cells: numericCells(categories, colleges, (row, column) => courseCounts[row]![column]! + countChanges[(row + column) % 6]!),\n' +
      '      encoding: { kind: "bubble", domainMax: 100, maxRadius: 18 }, rowHeaderLabel: "课程类别", valueFormat: String },\n' +
      '    { id: "support-level", caption: "课程支撑关系", description: "支撑关系只有无直接支撑、一般支撑和核心支撑三个等级。", sourceIds: ["CH145"],\n' +
      '      rows: courses, columns: requirements, cells: numericCells(courses, requirements, (row, column) => supportLevels[row]![column]!), rowHeaderLabel: "课程",\n' +
      '      encoding: { kind: "level", levels: [\n' +
      '        { value: 0, label: "无直接支撑", color: "var(--chart-scale-01)" },\n' +
      '        { value: 1, label: "一般支撑", color: "var(--chart-scale-03)" },\n' +
      '        { value: 2, label: "核心支撑", color: "var(--chart-scale-05)" },\n' +
      '      ] } },\n' +
      '  ];\n' +
      '  return fixtures.map(fixture => {\n' +
      '    if (state === "empty") return { ...fixture, rows: [], cells: [] };\n' +
      '    if (state === "single") return { ...fixture, rows: fixture.rows.slice(0, 1), columns: fixture.columns.slice(0, 1), cells: fixture.cells.filter(cell => cell.rowId === fixture.rows[0]!.id && cell.columnId === fixture.columns[0]!.id) };\n' +
      '    if (state === "long") return { ...fixture, rows: fixture.rows.map(row => ({ ...row, label: `${row.label}·跨学科协同与教学实践研究方向` })), columns: fixture.columns.map(column => ({ ...column, label: `${column.label}·联合培养与课程创新项目` })) };\n' +
      '    const cells = fixture.cells.map<MatrixCell>((cell, index) => {\n' +
      '      if (state === "missing" && index === 0 || state === "zero" && fixture.id === "course-version" && cell.kind === "value") return { rowId: cell.rowId, columnId: cell.columnId, kind: "missing", label: fixture.id === "course-version" ? "未设学期" : "缺测" };\n' +
      '      if (state === "invalid" && index === 0) return { rowId: cell.rowId, columnId: cell.columnId, kind: "value", value: NaN };\n' +
      '      return state === "zero" && cell.kind === "value" ? { ...cell, value: 0 } : cell;\n' +
      '    });\n' +
      '    return { ...fixture, cells, encoding: state === "zero" && fixture.encoding.kind === "bubble" ? { ...fixture.encoding, domainMax: 0 } : fixture.encoding };\n' +
      '  });\n' +
      '}\n',
    'chart-business/network-examples.tsx': 'import { useEffect, useMemo, useState } from "react";\n' +
      'import { AnimatePresence, motion, useIsPresent } from "motion/react";\n' +
      'import { NetworkChart, layoutNetwork, type NetworkNode, type NetworkEdge, type RainChartRecipe, type NetworkChartVariant } from "@rain-next/ui/charts";\n' +
      'import { makeNetworkFixtures, type NetworkFixtureId, type NetworkChartState } from "./network-data";\n' +
      'import "./network-page.css";\n' +
      '\n' +
      'export function filterNetwork(nodes: readonly NetworkNode[], edges: readonly NetworkEdge[], relation: string) {\n' +
      '  if (relation === "all") return { nodes, edges };\n' +
      '  const filtered = edges.filter(edge => edge.relation === relation);\n' +
      '  const connected = new Set(filtered.flatMap(edge => [edge.source, edge.target]));\n' +
      '  return { nodes: nodes.filter(node => connected.has(node.id)), edges: filtered };\n' +
      '}\n' +
      '\n' +
      'function NetworkExample({ fixture, relation, recipe, variant, reduced }: { fixture: ReturnType<typeof makeNetworkFixtures>[number]; relation: string; recipe: RainChartRecipe; variant: NetworkChartVariant; reduced: boolean }) {\n' +
      '  const present = useIsPresent();\n' +
      '  const [selectedId, setSelectedId] = useState<string | null>(null);\n' +
      '  const prepared = useMemo(() => {\n' +
      '    try {\n' +
      '      const model = layoutNetwork(fixture.nodes, fixture.edges);\n' +
      '      if (variant === "glow") return { nodes: model.nodes, error: undefined };\n' +
      '      const sources = new Set(model.edges.map(edge => edge.source)), targets = new Set(model.edges.map(edge => edge.target));\n' +
      '      const mapping = model.edges.length > 0 && model.edges.every(edge => edge.directed) && model.nodes.every(node => sources.has(node.id) !== targets.has(node.id));\n' +
      '      const columns = mapping ? [model.nodes.filter(node => sources.has(node.id)), model.nodes.filter(node => targets.has(node.id))] : fixture.categories.map(category => model.nodes.filter(node => node.category === category.id)).filter(column => column.length);\n' +
      '      if (columns.flat().length !== model.nodes.length) throw new Error("网络节点类别配置缺失或重复");\n' +
      '      if (mapping) for (let pass = 0; pass < 2; pass++) for (const [index, column] of columns.entries()) {\n' +
      '        const opposite = columns[1 - index]!;\n' +
      '        const rank = (node: NetworkNode) => {\n' +
      '          const neighbors = model.edges.filter(edge => edge.source === node.id || edge.target === node.id).map(edge => opposite.findIndex(other => other.id === (edge.source === node.id ? edge.target : edge.source)));\n' +
      '          return neighbors.reduce((sum, value) => sum + value, 0) / neighbors.length;\n' +
      '        };\n' +
      '        column.sort((a, b) => rank(a) - rank(b) || a.id.localeCompare(b.id));\n' +
      '      }\n' +
      '      else for (const column of columns) column.sort((a, b) => a.y - b.y || a.id.localeCompare(b.id));\n' +
      '      return { nodes: columns.flatMap((column, index) => column.map((node, row) => ({ ...node, x: columns.length < 2 ? .5 : .1 + index * .8 / (columns.length - 1), y: column.length < 2 ? .5 : .1 + row * .8 / (column.length - 1) }))), error: undefined };\n' +
      '    }\n' +
      '    catch (cause) { return { nodes: [], error: cause instanceof Error ? cause.message : "无效网络数据" }; }\n' +
      '  }, [fixture, variant]);\n' +
      '  const { error } = prepared;\n' +
      '  useEffect(() => { if (error) setSelectedId(null); }, [error]);\n' +
      '  const filtered = useMemo(() => filterNetwork(prepared.nodes, fixture.edges, relation), [prepared.nodes, fixture.edges, relation]);\n' +
      '  const selected = filtered.nodes.find(node => node.id === selectedId);\n' +
      '  return <section className="rain-network-example rain-chart" data-network-example={fixture.id} data-recipe={recipe} inert={!present} aria-hidden={!present || undefined}>\n' +
      '    <header><span className="rain-network-reference">{fixture.reference}</span><h2>{fixture.title}</h2></header>\n' +
      '    <p className="rain-network-description">{fixture.description}</p>\n' +
      '    {error ? <p className="rain-network-state" role="alert">已拒绝无效数据：{error}</p> : <>\n' +
      '      <NetworkChart variant={variant} data-recipe={recipe} nodes={filtered.nodes} edges={filtered.edges} categories={fixture.categories.map((category, index) => ({ ...category, color: `var(--chart-${index + 1})` }))} relations={fixture.relations.map((item, index) => ({ ...item, color: `var(--chart-${index + 1})`, lineStyle: (["solid", "dashed", "dotted"] as const)[index % 3] }))} caption={fixture.title} reducedMotion={reduced} onNodeSelect={node => setSelectedId(node?.id ?? null)} />\n' +
      '      {filtered.nodes.length > 0 && <p className="rain-network-feedback" role="status">{selected ? `已选择：${selected.label}` : "选择节点查看关联详情；也可通过节点列表操作。"}</p>}\n' +
      '      <p className="rain-network-note">当前 {filtered.nodes.length} 个节点、{filtered.edges.length} 条关系 · 示例数据。节点位置只帮助阅读连接，距离不表示相关度。{variant === "structured" && " 分组列不表示先修阶段。"}</p>\n' +
      '    </>}\n' +
      '  </section>;\n' +
      '}\n' +
      '\n' +
      'export function NetworkExamples({ fixtureId, state = "normal", revision = 0, relation = "all", recipe = "monochrome-blue", variant = "glow", reduced = false }: { fixtureId?: NetworkFixtureId; state?: NetworkChartState; revision?: number; relation?: string; recipe?: RainChartRecipe; variant?: NetworkChartVariant; reduced?: boolean }) {\n' +
      '  const fixtures = useMemo(() => makeNetworkFixtures(revision, state), [revision, state]);\n' +
      '  return <div style={{ position: "relative" }}><AnimatePresence mode="popLayout" initial={false}>{fixtures.filter(fixture => !fixtureId || fixture.id === fixtureId).map(fixture => <motion.div key={fixture.id} initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} transition={{ duration: reduced ? 0 : .18 }}><NetworkExample fixture={fixture} relation={relation} recipe={recipe} variant={variant} reduced={reduced} /></motion.div>)}</AnimatePresence></div>;\n' +
      '}\n',
    'chart-business/network-data.ts': 'import type { NetworkNode, NetworkEdge } from "@rain-next/ui/charts";\n' +
      '\n' +
      'export type NetworkFixtureId = "elements" | "knowledge" | "courses" | "practice";\n' +
      'export type NetworkChartState = "normal" | "empty" | "single" | "long" | "invalid";\n' +
      'export type NetworkFixture = {\n' +
      '  id: NetworkFixtureId; reference: string; title: string; description: string;\n' +
      '  nodes: NetworkNode[]; edges: NetworkEdge[];\n' +
      '  categories: { id: string; label: string }[];\n' +
      '  relations: { id: string; label: string }[];\n' +
      '};\n' +
      '\n' +
      'export const NETWORK_FIXTURES: { id: NetworkFixtureId; label: string }[] = [\n' +
      '  { id: "elements", label: "元素与知识点" }, { id: "knowledge", label: "知识点关联" },\n' +
      '  { id: "courses", label: "课程先修关系" }, { id: "practice", label: "理论与实践课程" },\n' +
      '];\n' +
      '\n' +
      'export function makeNetworkFixtures(revision = 0, state: NetworkChartState = "normal"): NetworkFixture[] {\n' +
      '  const change = revision % 3;\n' +
      '  const fixtures: NetworkFixture[] = [\n' +
      '    {\n' +
      '      id: "elements", reference: "CH-065", title: "教学元素与知识点关系",\n' +
      '      description: "全 Mock 示例：资源、学习活动与知识点使用不同节点类别。支撑、考查和应用分别表示关系类型；箭头从教学元素指向知识点。",\n' +
      '      categories: [{ id: "resource", label: "教学资源" }, { id: "activity", label: "学习活动" }, { id: "knowledge", label: "知识点" }],\n' +
