      '      <span aria-hidden="true" style={{ width: 10, height: 10, borderRadius: "50%", flexShrink: 0, background: item.color }} /><span>{item.label}</span>{showValue && <span style={{ color: "var(--legend-muted-foreground)" }}>{item.value}</span>}\n' +
