      '    renderItem={({ item, index, isHovered, isFaded }) => <button type="button" className="rain-chart-legend-button" onFocus={() => onHover(index)} onBlur={() => onHover(null)} onClick={() => onHover(index)} style={{ display: "flex", alignItems: "center", gap: 8, border: 0, borderRadius: 8, padding: "6px 8px", font: "inherit", color: "var(--legend-foreground)", background: isHovered ? "var(--legend-muted)" : "transparent", opacity: isFaded ? .4 : 1, cursor: "pointer" }}>\n' +
      '      <span aria-hidden="true" style={{ width: 10, height: 10, borderRadius: "50%", flexShrink: 0, background: item.color }} /><span>{item.label}</span>{showValue && <span style={{ color: "var(--legend-muted-foreground)" }}>{item.value}</span>}\n' +
      '    </button>} />;\n' +
      '}\n' +
      '\n' +
      'export function VariantTable({ data, caption = "示例精确数据" }: { data: Record<string, unknown>[]; caption?: string }) {\n' +
      '  const keys = Array.from(new Set(data.flatMap(row => Object.keys(row))));\n' +
      '  function cell(value: unknown): ReactNode {\n' +
