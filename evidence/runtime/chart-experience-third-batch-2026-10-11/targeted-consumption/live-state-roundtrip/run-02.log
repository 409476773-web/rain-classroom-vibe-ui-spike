      '\n' +
      'export type MiniProgressState = "normal" | "zero" | "missing" | "invalid" | "inapplicable" | "overflow";\n' +
      'export function getProgressReading(value: number | null, maxValue: number): { state: MiniProgressState; fraction: number | null; percentText: string } {\n' +
      '  if (!Number.isFinite(maxValue) || maxValue < 0 || (value !== null && (!Number.isFinite(value) || value < 0 || (maxValue === 0 && value > 0)))) return { state: "invalid", fraction: null, percentText: "无效数据" };\n' +
      '  if (value === null) return { state: "missing", fraction: null, percentText: "缺测" };\n' +
      '  if (maxValue === 0) return { state: "inapplicable", fraction: null, percentText: "不适用" };\n' +
      '  if (value > maxValue) return { state: "overflow", fraction: null, percentText: "超出范围" };\n' +
      '  const fraction = value / maxValue;\n' +
      '  return { state: value === 0 ? "zero" : "normal", fraction, percentText: `${Math.round(fraction * 100)}%` };\n' +
      '}\n' +
      '\n' +
      'export function selectMiniRows(original: MiniRow[], { many = false, descending = false, filter = false }: { many?: boolean; descending?: boolean; filter?: boolean }) {\n' +
      '  let rows = many && original.length ? Array.from({ length:40 },(_,index) => ({ ...original[index % original.length]!,id:`${original[index % original.length]!.id}-${index}`,label:`${original[index % original.length]!.label} ${index+1}` })) : original;\n' +
      '  if (filter) rows = rows.filter(row => (row.count ?? 0) >= 50);\n' +
      '  if (descending) rows = [...rows].sort((a,b) => (b.count ?? 0) - (a.count ?? 0));\n' +
      '  return rows;\n' +
      '}\n' +
      '\n' +
      'export function compositionState(values: (number | null)[]) {\n' +
      '  if (!values.length) return "empty";\n' +
      '  if (values.some(value => value !== null && (!Number.isFinite(value) || value < 0))) return "invalid";\n' +
      '  if (values.includes(null)) return "missing";\n' +
      '  const total = values.reduce<number>((sum, value) => sum + (value ?? 0), 0);\n' +
      '  return !Number.isFinite(total) ? "invalid" : total === 0 ? "zero" : "normal";\n' +
      '}\n',
    'chart-business/mini-layout.ts': 'export type MiniSize = "compact" | "comfortable";\n' +
