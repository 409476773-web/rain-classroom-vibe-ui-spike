      '    [[.70, .18], [.48, .32], [.38, .42], [.56, .28], [.34, .46]],\n' +
      '  ] as const;\n' +
      '  const progressValues = [[68, 42, 84, 56, 76], [82, 58, 91, 69, 64], [61, 49, 78, 73, 88]] as const;\n' +
      '  const trendProfiles = [[.32, .42, .60, .76, .86, .82, .66, .54], [.70, .56, .44, .40, .48, .66, .82, .90], [.45, .60, .74, .80, .72, .56, .44, .50]] as const;\n' +
      '  return labels.slice(0, state === "single" ? 1 : 5).map((label, index) => {\n' +
      '    const count = state === "zero" ? 0 : state === "missing" && index === 0 ? null : state === "invalid" && index === 0 ? NaN : index === 0 ? [25,75,50,25][revision % 4]! : counts[index]! + (index === 2 ? 0 : revision % 4 * 3);\n' +
      '    const [doneShare, activeShare] = curated ? compositionRatios[revision % 3]![index]! : [.5, .3] as const;\n' +
      '    return { id: `college-${index + 1}`, label: state === "long" ? `${label}·跨学科创新与教学研究中心` : label, count,\n' +
      '      trend: Array.from({ length: 8 }, (_, slot) => count === null ? null : count === 0 ? 0 : curated ? Math.round(count * trendProfiles[(revision + index) % trendProfiles.length]![slot]!) : Math.max(0, Math.round(count * (.35 + slot * .075) + (slot % 3 - 1) * 4))),\n' +
      '      parts: count === null ? [null, 3, 2] : [Math.round(count * doneShare), Math.round(count * activeShare), Math.max(0, count - Math.round(count * doneShare) - Math.round(count * activeShare))],\n' +
      '      completed: count === null ? null : state === "zero" ? 0 : curated ? progressValues[revision % 3]![index]! : Math.min(100, 20 + index * 15 + revision % 4 * 4), goal: state === "zero" ? 0 : 100 };\n' +
      '  });\n' +
