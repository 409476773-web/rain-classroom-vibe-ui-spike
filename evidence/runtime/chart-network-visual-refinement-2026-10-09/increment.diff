+const textWidth = (text: string) => [...text].reduce((sum, character) => sum + (/[^\u0000-\u007f]/.test(character) ? 14 : 8), 0);
+const overlaps = (a: Box, b: Box) => a.x < b.x + b.width && a.x + a.width > b.x && a.y < b.y + b.height && a.y + a.height > b.y;
