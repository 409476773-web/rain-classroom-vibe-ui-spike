import {
  forwardRef,
  type ButtonHTMLAttributes,
  type MouseEvent,
  type ReactNode,
} from "react";

import { useDensity } from "@rain-next/foundations";

export type ButtonVariant = "primary" | "secondary" | "tertiary" | "text";
export type ButtonTone = "default" | "danger";
export type ButtonSize = "mini" | "small" | "medium" | "large" | "xl";
export type ButtonTextTone = "default" | "brand" | "danger";
export type ButtonTextSize = "small" | "compact" | "regular";

interface ButtonSharedProps extends ButtonHTMLAttributes<HTMLButtonElement> {
  children: ReactNode;
  leadingIcon?: ReactNode;
  loading?: boolean;
  loadingLabel?: ReactNode;
  trailingIcon?: ReactNode;
}

export type ButtonProps = ButtonSharedProps & (
  | {
      block?: boolean;
      size?: ButtonSize;
      tone?: ButtonTone;
      variant?: Exclude<ButtonVariant, "text">;
    }
  | {
      block?: never;
      size?: ButtonTextSize;
      tone?: ButtonTextTone;
      variant: "text";
    }
);

function mergeClassNames(...names: Array<string | undefined>) {
  return names.filter(Boolean).join(" ");
}

export const Button = forwardRef<HTMLButtonElement, ButtonProps>(
  function Button(
    {
      "aria-busy": ariaBusy,
      "aria-disabled": ariaDisabled,
      block = false,
      children,
      className,
      disabled = false,
      leadingIcon,
      loading = false,
      loadingLabel,
      onClick,
      size,
      tone = "default",
      trailingIcon,
      type = "button",
      variant = "secondary",
      ...nativeProps
    },
    ref,
  ) {
    const density = useDensity();
    const resolvedSize = size ?? (
      variant === "text"
        ? density === "compact" ? "compact" : "regular"
        : density === "compact" ? "small" : "medium"
    );
    const isTextAriaDisabled = variant === "text"
      && (ariaDisabled === true || ariaDisabled === "true");
    const state = disabled || isTextAriaDisabled
      ? "disabled"
      : loading ? "loading" : "default";

    function handleClick(event: MouseEvent<HTMLButtonElement>) {
      if (loading || isTextAriaDisabled) {
        event.preventDefault();
        event.stopPropagation();
        return;
      }
      onClick?.(event);
    }

    return (
      <button
        {...nativeProps}
        ref={ref}
        aria-busy={loading ? true : ariaBusy}
        aria-disabled={loading ? true : ariaDisabled}
        className={mergeClassNames("rain-button", className)}
        data-block={block || undefined}
        data-density={density}
        data-focus="control"
        data-rain-id="ui-button"
        data-size={resolvedSize}
        data-slot="root"
        data-state={state}
        data-tone={tone}
        data-variant={variant}
        disabled={disabled}
        onClick={handleClick}
        type={type}
      >
        {loading ? (
          <span aria-hidden="true" data-slot="loading-indicator" />
        ) : leadingIcon ? (
          <span aria-hidden="true" data-slot="leading-icon">
            {leadingIcon}
          </span>
        ) : null}
        <span data-slot="label">
          {loading && loadingLabel !== undefined ? loadingLabel : children}
        </span>
        {!loading && trailingIcon ? (
          <span aria-hidden="true" data-slot="trailing-icon">
            {trailingIcon}
          </span>
        ) : null}
      </button>
    );
  },
);

Button.displayName = "Button";
