.native-baseline {
  width: min(1080px, calc(100% - 64px));
  min-height: 100vh;
  padding: 48px 0;
  margin: 0 auto;
  color: var(--rain-color-text-primary);
}

.native-baseline__header {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 32px;
  align-items: end;
  padding: 32px;
  background: var(--rain-color-surface-panel);
  border: 1px solid var(--rain-color-border-default);
  border-radius: var(--rain-radius-10);
}

.native-baseline__eyebrow,
.native-baseline__section-index {
  margin: 0 0 8px;
  color: var(--rain-color-brand-primary);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.native-baseline h1 {
  margin: 0;
  font-size: 32px;
  font-weight: 600;
  line-height: 42px;
}

.native-baseline__intro {
  max-width: 640px;
  margin: 10px 0 0;
  color: var(--rain-color-text-muted);
}

.native-baseline__status {
  padding: 7px 12px;
  color: var(--rain-color-text-secondary);
  font-size: 12px;
  font-weight: 600;
  background: var(--rain-color-surface-subtle);
  border: 1px solid var(--rain-color-border-default);
  border-radius: var(--rain-radius-full);
}

.native-baseline__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: 16px;
}

.native-baseline__section {
  padding: 28px;
  background: var(--rain-color-surface-panel);
  border: 1px solid var(--rain-color-border-default);
  border-radius: var(--rain-radius-8);
}

.native-baseline__section--control {
  border-style: dashed;
}

.native-baseline__section-heading {
  display: flex;
  gap: 20px;
  align-items: start;
  justify-content: space-between;
}

.native-baseline__section-heading h2 {
  margin: 0;
  font-size: 20px;
  font-weight: 600;
  line-height: 28px;
}

.native-baseline__scope-chip {
  flex: none;
  padding: 5px 8px;
  color: var(--rain-color-brand-primary-strong);
  font-size: 11px;
  font-weight: 600;
  background: var(--rain-color-brand-primary-subtle);
  border-radius: var(--rain-radius-4);
}

.native-baseline__scope-chip--locked {
  color: var(--rain-color-text-secondary);
  background: var(--rain-color-surface-subtle);
}

.native-baseline__field {
  display: grid;
  gap: 8px;
  margin-top: 38px;
}

.native-baseline__field > label {
  color: var(--rain-color-text-secondary);
  font-size: 13px;
  font-weight: 600;
}

.native-baseline__operation {
  display: flex;
  gap: 8px;
  align-items: center;
}

.native-baseline__target-input,
.native-baseline__control-input {
  width: 320px;
}

.native-baseline .native-baseline__target-input {
  background: var(--rain-color-surface-subtle);
}

@media (max-width: 840px) {
  .native-baseline {
    width: min(100% - 28px, 1080px);
    padding: 28px 0;
  }

  .native-baseline__header,
  .native-baseline__grid {
    grid-template-columns: 1fr;
  }

  .native-baseline__status {
    justify-self: start;
  }

  .native-baseline__operation {
    align-items: stretch;
    flex-direction: column;
  }

  .native-baseline__target-input,
  .native-baseline__control-input {
    width: 100%;
  }
}
