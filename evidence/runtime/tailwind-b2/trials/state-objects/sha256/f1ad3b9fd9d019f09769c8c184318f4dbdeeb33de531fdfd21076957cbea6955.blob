import { Button, Input } from "@rain-next/ui";
import { SearchIcon } from "@rain-next/ui/icons/search";

import { LocalSearchInput } from "./local-search-input";
import "./page.css";

export function TailwindB2NativeBaselinePage() {
  return (
    <main
      className="native-baseline"
      data-asset-identity="local-experiment"
      data-maturity="local-experiment"
      data-rain-id="tailwind-b2-native-baseline"
      data-slot="benchmark-fixture"
    >
      <header className="native-baseline__header">
        <div>
          <p className="native-baseline__eyebrow">
            B2 COMMON FIXTURE · NATIVE CSS ARM
          </p>
          <h1 id="tailwind-b2-native-baseline-title" tabIndex={-1}>
            搜索操作区共同夹具
          </h1>
          <p className="native-baseline__intro rain-type-reading">
            两个区域共用当前 Button、Input 与正式搜索图标。后续只允许修改标记为目标的当前功能。
          </p>
        </div>
        <output
          aria-label="共同夹具状态"
          className="native-baseline__status"
          data-state="fixture-frozen"
        >
          夹具已冻结 · P1 / P2 / P3 尚未执行
        </output>
      </header>

      <div className="native-baseline__grid">
        <section
          aria-labelledby="native-baseline-target-title"
          className="native-baseline__section"
          data-scope="target-search"
        >
          <header className="native-baseline__section-heading">
            <div>
              <p className="native-baseline__section-index">TARGET · CURRENT FEATURE</p>
              <h2 id="native-baseline-target-title">当前搜索区</h2>
            </div>
            <span className="native-baseline__scope-chip">允许局部调整</span>
          </header>
          <div className="native-baseline__field">
            <label htmlFor="native-baseline-target-keyword">当前搜索区关键词</label>
            <div className="native-baseline__operation">
              <Input
                className="native-baseline__target-input"
                id="native-baseline-target-keyword"
                placeholder="输入课程名称"
                prefix={<SearchIcon size={16} />}
              />
              <Button variant="primary">搜索当前课程</Button>
            </div>
          </div>
          <div className="native-baseline__field native-baseline__field--second">
            <label htmlFor="native-baseline-second-keyword">
              当前搜索区第二状态关键词
            </label>
            <div className="native-baseline__operation">
              <LocalSearchInput
                className="native-baseline__target-input"
                id="native-baseline-second-keyword"
                placeholder="输入章节名称"
                prefix={<SearchIcon size={16} />}
                scopeLabel="课程范围"
                scopeLabelId="native-baseline-second-scope-label"
              />
              <Button variant="primary">搜索当前章节</Button>
            </div>
          </div>
        </section>

        <section
          aria-labelledby="native-baseline-control-title"
          className="native-baseline__section native-baseline__section--control"
          data-scope="non-target-controls"
        >
          <header className="native-baseline__section-heading">
            <div>
              <p className="native-baseline__section-index">CONTROL · OTHER FEATURE</p>
              <h2 id="native-baseline-control-title">非目标控件对照</h2>
            </div>
            <span className="native-baseline__scope-chip native-baseline__scope-chip--locked">
              必须保持不变
            </span>
          </header>
          <div className="native-baseline__field">
            <label htmlFor="native-baseline-control-keyword">其他功能关键词</label>
            <div className="native-baseline__operation">
              <Input
                className="native-baseline__control-input"
                id="native-baseline-control-keyword"
                placeholder="输入其他内容"
                prefix={<SearchIcon size={16} />}
              />
              <Button variant="secondary">其他功能操作</Button>
            </div>
          </div>
        </section>
      </div>
    </main>
  );
}
