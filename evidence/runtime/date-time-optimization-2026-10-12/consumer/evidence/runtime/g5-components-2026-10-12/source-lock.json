  "adaptations": {
    "label-field": "Map to existing FormItem, own Checkbox/Radio labels and existing Layout; no duplicate public components.",
    "input-group": "Retain existing inline Input/SearchInput/InputNumber; add native Textarea blockStart/blockEnd, decorative click focus and permission rules.",
    "native-select": "Retain native wrapper/control/decorative arrow/option/optgroup anatomy; use Rain field frame/Input reset and native system option paint.",
    "combobox": "Base UI owns one Root/InputGroup/Input/List/Portal lifecycle; Rain Input/menu/PopupProvider provide parts. Base UI 1.8 InputGroup aria-live=off preserves sibling Clear/Trigger accessibility. Retry restores input focus.",
    "slider": "Retain Root/Control/Track/Indicator/Thumb, stable index/collision=none and native range inputs. Use solid existing Brand thumb and Alpha/6 track for declared state contrast; no position tween.",
    "calendar": "DayPicker 9.13.2, Chinese Monday, formal Select/IconButton/Button parts. Rain Button label inherits day state; retain all eight version-matched animation classes and cleanup with 220ms Region/reduced-motion.",
    "date-picker": "Compose existing Popover/Calendar/InputNumber, with confirm-only draft state, complete ranges, local-minute validation and responsive month/time layout. No second popup engine.",
    "colors-motion": "Rain existing Tokens only; Combo/DatePicker 180ms, Calendar220ms, feedback140ms. Local arrow/outside/placeholder/selected-hover/thumb/track adjustments resolve measured insufficiencies; eligibility, inherited field findings and Human Gates remain separate."
  }
