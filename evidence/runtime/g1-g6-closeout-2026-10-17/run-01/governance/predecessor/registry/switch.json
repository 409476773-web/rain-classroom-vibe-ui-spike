{
  "schemaVersion": 1,
  "kind": "RainLocalSourceRegistry",
  "publication": "not-published",
  "scope": "current-workspace",
  "humanGate": "accepted",
  "humanGateScope": "switch-runtime-visual-only",
  "contrastAcceptance": "not-granted",
  "shared": {
    "files": [
      "packages/ui/src/styles.css",
      "packages/ui/src/utils/rain-class-names.ts",
      "packages/ui/src/utils/use-default-reset.ts"
    ],
    "peerDependencies": [
      "react",
      "@base-ui/react",
      "@rain-next/foundations",
      "tailwind-merge"
    ],
    "styleDependencies": [
      "@rain-next/foundations/tokens.css",
      "@rain-next/foundations/focus.css",
      "@rain-next/foundations/motion.css",
      "@rain-next/foundations/tailwind-theme.css",
      "@rain-next/ui/styles.css"
    ],
    "registryDependencies": []
  },
  "items": [
    {
      "name": "switch",
      "exportName": "Switch",
      "importPath": "@rain-next/ui",
      "manifest": "manifests/ui/switch.yaml",
      "files": [
      "packages/ui/src/switch/switch.tsx",
      "packages/ui/src/styles.css"
      ],
      "dependencies": [
        "packages/ui/src/icon/icon.tsx",
        "packages/ui/src/icons/button-loading.tsx",
        "packages/ui/src/icons/assets/button-loading.png"
      ]
    }
  ]
}
