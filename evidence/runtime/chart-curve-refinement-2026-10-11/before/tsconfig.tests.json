{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx",
    "packages/**/*.test.ts",
    "packages/**/*.test.tsx",
    "tests/**/*.ts",
    "scripts/**/*.test.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
