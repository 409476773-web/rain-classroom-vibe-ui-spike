{
  "name": "@rain-next/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @rain-next/playground dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit --project tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:lockfile": "pnpm install --lockfile-only --frozen-lockfile --offline --ignore-scripts",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:tailwind-b2": "node scripts/verify-tailwind-b2.mjs",
    "generate:tokens": "node scripts/generate-token-foundations.mjs",
    "verify:tokens": "node scripts/verify-token-foundations.mjs",
    "verify:reuse-audit": "node scripts/verify-rain-classic-reuse-audit.mjs",
    "verify:governance": "pnpm verify:lockfile && pnpm verify:workspace && pnpm verify:evidence && pnpm verify:boundaries && pnpm verify:tailwind-b2 && pnpm verify:tokens && pnpm verify:css-variables && pnpm verify:playground-status",
    "verify": "pnpm verify:governance && pnpm verify:icons && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "generate:icons": "node scripts/generate-icons.mjs",
    "verify:icons": "node scripts/verify-icons.mjs",
    "verify:css-variables": "node scripts/verify-css-variables.mjs",
    "verify:playground-status": "node scripts/playground-status.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
